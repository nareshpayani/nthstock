{
  "name": "@nthstock/marketData",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "TZ=UTC vitest run --coverage && TZ=America/New_York vitest run"
  },
  "dependencies": {
    "@faker-js/faker": "10.6.0",
    "@nthstock/contracts": "0.0.0",
    "@nthstock/utils": "0.0.0"
  },
  "peerDependencies": {
    "vitest": "5.0.2"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nthstock/config": "0.0.0",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2"
  }
}
