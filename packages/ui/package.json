{
  "name": "@nthstock/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./allIcons": {
      "types": "./dist/icons/allIcons.d.ts",
      "import": "./dist/icons/allIcons.js"
    },
    "./styles.css": "./styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --test",
    "test-storybook": "test-storybook --index-json --excludeTags a11y-canary",
    "test-storybook:canary": "test-storybook --index-json --includeTags a11y-canary"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@nthstock/utils": "0.0.0",
    "@tanstack/react-virtual": "3.14.13",
    "class-variance-authority": "0.7.1",
    "radix-ui": "1.6.7",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@nthstock/config": "0.0.0",
    "@nthstock/tokens": "0.0.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@storybook/test-runner": "0.24.5",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "10.6.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
