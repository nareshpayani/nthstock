{
  "extends": "@nthstock/config/tsconfig.base.json",
  "compilerOptions": {
    // DOM for the fetch and WebSocket types only: Node 22 and browsers both provide them, and the
    // client never touches document or window.
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": [],
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true
  },
  "include": ["src"]
}
