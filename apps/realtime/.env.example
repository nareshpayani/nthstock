# apps/realtime local settings. Copy to .env if you need to change them; no secrets belong here.
PORT=8081
HOST=0.0.0.0
# Redis carrying ticks from apps/api (npm run infra:up starts it on this address).
REDIS_URL=redis://127.0.0.1:6379
# development, test or production.
NODE_ENV=development
# HS256 key of the access JWT, the same value as apps/api's JWT_SECRET (at least 32 characters).
# Required in production. `npm run dev:api` generates one key and passes it to both apps.
JWT_SECRET=
