{
  "name": "@nthstock/realtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:latency": "vitest run --config vitest.latency.config.ts"
  },
  "dependencies": {
    "@nthstock/contracts": "0.0.0",
    "@nthstock/marketData": "0.0.0",
    "ioredis": "6.0.0",
    "jose": "6.2.13",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nthstock/config": "0.0.0",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
