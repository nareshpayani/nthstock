# Web runtime config (T-049). Copy to .env.local to override. Every VITE_* value is inlined into the
# shipped JavaScript, so never put a secret here. Blank means "use the default".

# msw (default): REST and WebSocket are mocked in the browser by MSW.
# api: talk to apps/api (REST /v1) and apps/realtime (WebSocket).
VITE_API_MODE=msw

# Origin of the REST API, without /v1. Blank: the page's own origin.
VITE_API_BASE_URL=

# Realtime WebSocket URL. Blank: ws(s)://<page host>/ws.
VITE_WS_URL=

# msw mode only: tick the mock market outside NSE hours (demos, e2e). true or false.
VITE_MOCK_MARKET_OPEN=false

# api mode dev/preview proxy targets (not VITE_*, never shipped). Blank: the defaults below.
# API_PROXY_TARGET=http://127.0.0.1:4000
# REALTIME_PROXY_TARGET=ws://127.0.0.1:8081

# msw mode, E2E builds only: ship the MSW /v1/__test clock and price handlers (Playwright sets it).
# Never set it for a build anyone else will load. true or false.
VITE_TEST_CONTROLS=false
