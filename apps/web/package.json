{
  "name": "@nthstock/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "turbo run build --filter=@nthstock/web^...",
    "dev": "vite",
    "build": "vite build && node scripts/checkBuild.mjs && npm run build:api-check",
    "preview": "vite preview",
    "lint": "eslint . && node scripts/checkNoHex.mjs src && node scripts/checkFeatureCycles.mjs src",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:api": "E2E_MODE=api playwright test",
    "e2e:dev": "E2E_DEV=1 playwright test",
    "e2e:perf": "E2E_PERF=1 playwright test",
    "e2e:deployed": "playwright test -c playwright.deployed.config.ts",
    "lhci": "npx --yes @lhci/cli@0.15.1 autorun --config=lighthouserc.cjs",
    "build:api-check": "VITE_API_MODE=api vite build --outDir dist-api --emptyOutDir --logLevel warn && node scripts/checkBuild.mjs dist-api",
    "e2e:walkthrough": "bash ../../tools/demo/recordWalkthrough.sh"
  },
  "devDependencies": {
    "@nthstock/config": "0.0.0",
    "@playwright/test": "1.64.1",
    "@storybook/react-vite": "10.6.3",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.47",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "axe-core": "4.14.0",
    "eslint": "10.13.0",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@nthstock/apiClient": "0.0.0",
    "@nthstock/contracts": "0.0.0",
    "@nthstock/marketData": "0.0.0",
    "@nthstock/paperEngine": "0.0.0",
    "@nthstock/tokens": "0.0.0",
    "@nthstock/ui": "0.0.0",
    "@nthstock/utils": "0.0.0",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-virtual": "3.14.21",
    "lightweight-charts": "5.2.1",
    "msw": "3.0.3",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
