# apps/api local settings. Copy to .env if you need to change them; no secrets belong here.
PORT=4000
HOST=0.0.0.0
# Let the mock market tick outside NSE hours (demos, e2e). true or false.
MOCK_MARKET_ALWAYS_OPEN=false
# Redis for publishing live ticks to apps/realtime (npm run infra:up). Blank: REST only, no ticks.
# Required with DB_DRIVER=postgres: OTP challenges, the resend throttle and the session revocation
# cache live there.
REDIS_URL=
# Follow apps/quotes instead of generating ticks: the number of shards it writes (its SHARDS).
# Needs REDIS_URL. Blank: this process runs its own random walk and tick pump.
QUOTE_SHARDS=
# The candle writer only (npm run dev:candles): how many shards apps/quotes writes (its SHARDS,
# default 1). The writer also reads DATABASE_URL and REDIS_URL, and needs both.
SHARDS=1
# development, test or production. Production draws random OTPs (the fixed dev OTP 123456 and the
# dev CAPTCHA token work only outside production) and never logs the OTP.
NODE_ENV=development
# HS256 key for the 15-min access JWT, shared with apps/realtime (at least 32 characters, e.g.
# `openssl rand -base64 48`). Required in production. Left blank elsewhere, each process makes an
# ephemeral key; `npm run dev:api` generates one key for both apps/api and apps/realtime.
JWT_SECRET=
# E2E only: registers the /v1/__test clock and price routes. Needs NODE_ENV=test; apps/api refuses
# to start with it in development or production. Leave false.
ENABLE_TEST_CONTROLS=false
# Local demos only (npm run seed:demo): load the demo user's watchlists, holdings and ledger at
# start-up. apps/api refuses it in production. true or false.
DEMO_SEED=false
# Where repos keep data: memory (default; nothing survives a restart) or postgres (needs
# DATABASE_URL; npm run dev:api sets it). GET /v1/health/ready checks Postgres only with postgres.
DB_DRIVER=memory
# Who runs the scheduled jobs (spec backend-core §9): inline (default; the API's in-process order
# sweep), bullmq (the job worker; npm run dev:api sets it and starts the worker; needs DB_DRIVER=postgres)
# or off.
JOBS_MODE=inline
# PostgreSQL (npm run infra:up; ADR 0007). Non-secret local dev passwords from infra/postgres/init.sql.
# apps/api connects as nthstock_app, which may read and write rows but never change the schema.
DATABASE_URL=postgres://nthstock_app:nthstock_app_dev@127.0.0.1:5432/nthstock
# Migrations only (npm run db:migrate -w @nthstock/api): nthstock_owner owns the schema.
DATABASE_MIGRATION_URL=postgres://nthstock_owner:nthstock_owner_dev@127.0.0.1:5432/nthstock
# Connections in apps/api's one Postgres pool (1 to 100). Keep the sum over all processes below
# the server's (or PgBouncer's) limit.
PG_POOL_MAX=10
# Column encryption for mobile, name and email (ADR 0007, spec backend-core §4.1). PII_ENC_KEYS is a
# comma-separated list of <id 1-255>:<base64 of 32 bytes>; the first is the current key, the others
# only decrypt (rotation). PII_HMAC_KEY (base64 of 32 bytes) keys the blind index that looks up a
# mobile. Make one with `openssl rand -base64 32`. Leave both blank locally to use fixed throwaway
# development keys; production refuses to start without real ones.
PII_ENC_KEYS=
PII_HMAC_KEY=
