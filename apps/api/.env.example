# apps/api local settings. Copy to .env if you need to change them; no secrets belong here.
PORT=4000
HOST=0.0.0.0
# Let the mock market tick outside NSE hours (demos, e2e). true or false.
MOCK_MARKET_ALWAYS_OPEN=false
# Redis for publishing live ticks to apps/realtime (npm run infra:up). Blank: REST only, no ticks.
REDIS_URL=
# development, test or production. Production draws random OTPs (the fixed dev OTP 123456 and the
# dev CAPTCHA token work only outside production) and never logs the OTP.
NODE_ENV=development
# HS256 key for the 15-min access JWT, shared with apps/realtime (at least 32 characters, e.g.
# `openssl rand -base64 48`). Required in production. Left blank elsewhere, each process makes an
# ephemeral key; `npm run dev:api` generates one key for both apps/api and apps/realtime.
JWT_SECRET=
