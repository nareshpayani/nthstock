{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-api/**"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "passThroughEnv": [
        "REDIS_TEST_URL",
        "POSTGRES_TEST_URL",
        "POSTGRES_TEST_POOLER_URL",
        "SKIP_REDIS_INTEGRATION",
        "SKIP_PG_INTEGRATION",
        "DOCKER_HOST",
        "TESTCONTAINERS_*"
      ]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "build-storybook": {
      "dependsOn": ["^build", "build", "@nthstock/apiClient#build", "@nthstock/marketData#build"],
      "outputs": ["storybook-static/**"]
    }
  }
}
